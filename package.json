{
  "name": "pounce",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './apps/**' run build",
    "typecheck": "pnpm -r run typecheck",
    "preinstall": "npx only-allow pnpm",
    "test": "pnpm --filter @pounce/core run build && pnpm -r run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "dev": "docker compose up -d postgres redis && pnpm -r --parallel run dev",
    "db:migrate": "pnpm --filter @pounce/db run migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.6.3"
  }
}
